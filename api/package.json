{
  "name": "wisepoker",
  "version": "1.0.0",
  "description": "A poker platform API for managing poker games, players, and tournaments.",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "prisma generate && tsup",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "start": "node dist/server.js"
  },
  "author": {
    "name": "Felipe Bernardes",
    "email": "felipe.bernardes.dev@gmail.com"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@pokertools/engine": "^2.0.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/fastify-api-reference": "^1.74.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.6"
  }
}
